# OpenWeatherMap API Key (used for live AQI and pollutant fetching)
OWM_API_KEY=a00174d020ab1cec2d561cbffadd4c96

# MongoDB Atlas Connection URI (optional, for historical city AQI storage)
# Leave blank to run purely on live API / manual input
MONGO_URL=

# MongoDB Database Name (defaults to AirQuality)
MONGO_DB=AirQuality

# Optional remote FastAPI URL (e.g. http://127.0.0.1:8000)
# If left blank, the dashboard will use the embedded Scikit-Learn model directly for instant predictions
API_URL=
